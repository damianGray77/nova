# Embeds a file as a C byte array (Phase 8: warp_isa.inc, which the GPU
# compiles at run time as HLSL while the CPU reference includes it as C++).
#   cmake -DIN=<file> -DOUT=<header> -DNAME=<array name> -P embed_bytes.cmake
# A byte array, not a string literal, so there is no limit on its length and
# nothing in the source needs escaping. The array ends with a 0.
file(READ "${IN}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUT}" "// Generated by tools/embed_bytes.cmake from ${IN}: do not edit.\n"
                    "static const unsigned char ${NAME}[] = {${bytes}0x00};\n")
